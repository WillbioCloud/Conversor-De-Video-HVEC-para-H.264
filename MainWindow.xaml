<ui:FluentWindow x:Class="ConversorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Conversor de Vídeo HEVC -> H.264" 
        Height="520" Width="750"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="/LogoApp.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Customizada (Min, Max, Fechar) -->
        <ui:TitleBar Grid.Row="0" Title="Conversor de Vídeo HEVC -> H.264">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/LogoApp.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho Atualizado com a Logo -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A Nova Logo SVG (usando SharpVectors) -->
            <svgc:SvgViewbox Grid.Column="0" 
                             Source="/LogoApp.svg" 
                             Height="48" 
                             Margin="0,0,16,0" 
                             VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Text="Conversor Apple HEVC para Android" 
                              FontTypography="Title" />
                <ui:TextBlock Text="Converta vídeos de iPhone para H.264 compatível com celulares Android." 
                              Appearance="Secondary" />
            </StackPanel>
        </Grid>

        <!-- Seleção de Vídeo -->
        <Border Grid.Row="1" Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtCaminhoVideo" 
                            PlaceholderText="Selecione o vídeo da Apple (.mov ou .mp4)..."
                            IsReadOnly="True" Margin="0,0,10,0" />
                <ui:Button Grid.Column="1" 
                           Content="Buscar Vídeo" 
                           Icon="{ui:SymbolIcon VideoClip24}" 
                           Click="BtnSelecionarVideo_Click" />
            </Grid>
        </Border>

        <!-- Configurações de Saída -->
        <Border Grid.Row="2" Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock Text="Resolução máxima:" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="CmbResolucao" SelectedIndex="1" Width="180">
                    <ComboBoxItem Content="Manter Original" Tag="original" />
                    <ComboBoxItem Content="1080p (Recomendado)" Tag="1080" />
                    <ComboBoxItem Content="720p (Mais Leve)" Tag="720" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Log / Lista de Processamento -->
        <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <TextBox x:Name="TxtLogs" 
                     IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     Text="Aguardando seleção de pasta..." />
        </Border>

        <!-- Barra de Progresso e Ação -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <ui:TextBlock x:Name="LblStatus" Text="Pronto para iniciar" Margin="0,0,0,6" />
                <ProgressBar x:Name="ProgressoConversao" Height="6" Minimum="0" Maximum="100" Value="0" />
            </StackPanel>

            <ui:Button x:Name="BtnConverter" 
                       Grid.Column="1" 
                       Content="Iniciar Conversão" 
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Play24}" 
                       Click="BtnConverter_Click" />
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>